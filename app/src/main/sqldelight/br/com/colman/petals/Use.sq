CREATE TABLE Use(
    date TEXT NOT NULL,
    amount_grams TEXT NOT NULL,
    cost_per_gram TEXT NOT NULL,
    id TEXT PRIMARY KEY,
    description TEXT NOT NULL DEFAULT "",
    consumption_method TEXT NOT NULL DEFAULT '',
    strain_id TEXT
);

CREATE INDEX use_strain_id ON Use(strain_id);

upsert:
INSERT INTO Use(date, amount_grams, cost_per_gram, id, description, consumption_method, strain_id) VALUES ?
ON CONFLICT (id) DO UPDATE SET date = excluded.date,
 amount_grams = excluded.amount_grams,
 description = excluded.description,
 consumption_method = excluded.consumption_method,
 strain_id = excluded.strain_id,
  cost_per_gram = excluded.cost_per_gram;

selectLast:
SELECT * FROM Use WHERE datetime(date) <= datetime('now', 'localtime') ORDER BY date DESC LIMIT 1;

selectAll:
SELECT * FROM Use;

selectSince:
SELECT * FROM Use
WHERE datetime(date) >= datetime(:from) AND datetime(date) <= datetime('now', 'localtime')
ORDER BY date ASC;

delete:
DELETE FROM Use WHERE id IS (?);

countAll:
SELECT COUNT(*) FROM Use;

selectStrainIds:
SELECT id, strain_id FROM Use WHERE strain_id IS NOT NULL;
