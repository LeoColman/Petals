CREATE TABLE Strain(
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    thc_percent TEXT,
    cbd_percent TEXT,
    cost_per_gram TEXT,
    is_archived INTEGER NOT NULL DEFAULT 0
);

upsert:
INSERT INTO Strain(id, name, thc_percent, cbd_percent, cost_per_gram, is_archived) VALUES ?
ON CONFLICT (id) DO UPDATE SET name = excluded.name,
 thc_percent = excluded.thc_percent,
 cbd_percent = excluded.cbd_percent,
 cost_per_gram = excluded.cost_per_gram,
 is_archived = excluded.is_archived;

selectAll:
SELECT * FROM Strain;

delete:
DELETE FROM Strain WHERE id IS (?);

countUses:
SELECT COUNT(*) FROM Use WHERE strain_id IS (?);

-- One row per use with a strain, with only the columns a strain's summary adds up, so no date or description is read.
-- It still reads every such use: the sums are taken in Kotlin, as BigDecimal, because SQLite would add the amounts up
-- as floating point.
selectStrainUses:
SELECT strain_id, amount_grams, cost_per_gram, rating FROM Use WHERE strain_id IS NOT NULL;
